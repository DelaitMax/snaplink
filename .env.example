POSTGRES_DB=snaplink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порты на хосте для postgres/redis — актуальны только для обычного
# docker-compose.yml (там все сервисы доступны с портов, удобно для
# локальной разработки/отладки через любой DB-клиент). В
# docker-compose.prod.yml эти порты не публикуются вовсе.
POSTGRES_PORT=5432
REDIS_PORT=6379

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_COOKIE_NAME=auth_token
JWT_EXPIRES_IN_SECONDS=604800

# Публичный URL, на котором будет доступен сервис
PUBLIC_BASE_URL=http://localhost:3000

# Порт на хосте, проброшенный в контейнер backend (внутри всегда 3000).
APP_PORT=3000

# Порт на хосте, проброшенный в контейнер frontend/nginx (внутри всегда 80).
# Именно этот адрес открывать в браузере — https?://localhost:$WEB_PORT
WEB_PORT=8080

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

REDIS_LINK_CACHE_TTL_SECONDS=60
GEO_API_BASE_URL=http://ip-api.com/json
GEO_LOOKUP_TIMEOUT_MS=2000
