POSTGRES_DB=snaplink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порты на хосте для postgres/redis — актуальны только для обычного
# docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_COOKIE_NAME=auth_token
JWT_EXPIRES_IN_SECONDS=604800

# Публичный origin именно backend'а (короткие ссылки + /api + /auth) —
# т.е. домен sh.example.com из deploy/nginx.conf.example
PUBLIC_BASE_URL=http://localhost:3000

# Порт на хосте, проброшенный в контейнер backend.
APP_PORT=3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

REDIS_LINK_CACHE_TTL_SECONDS=60
GEO_API_BASE_URL=http://ip-api.com/json
GEO_LOOKUP_TIMEOUT_MS=2000
# Сколько держать в Redis результат геолокации по IP (секунды). IP-геолокация
# почти не меняется, а бесплатный ip-api.com ограничен 45 запросами/мин без
# ключа — кэш подольше экономит этот лимит. По умолчанию 6 часов.
GEO_CACHE_TTL_SECONDS=21600
