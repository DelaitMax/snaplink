NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/snaplink

PUBLIC_BASE_URL=http://localhost:3000

# Необязательно: TTL по умолчанию для ссылок без явно указанного (в секундах).
# Если не задан — ссылки бессрочны, пока не деактивированы вручную.
# DEFAULT_LINK_TTL_SECONDS=2592000

# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_COOKIE_NAME=auth_token
JWT_EXPIRES_IN_SECONDS=604800

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Redis — кэш перед БД для redirect-эндпоинта. Не критичен: при недоступности
# сервис продолжает работать напрямую через БД (см. src/lib/redis.ts).
REDIS_URL=redis://localhost:6379
REDIS_LINK_CACHE_TTL_SECONDS=60

# Geo-провайдер для определения региона по IP (формат ответа как у ip-api.com).
GEO_API_BASE_URL=http://ip-api.com/json
GEO_LOOKUP_TIMEOUT_MS=2000
